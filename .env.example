# Convex Database Configuration
# Get this URL from your Convex dashboard: https://dashboard.convex.dev
CONVEX_URL=https://your-project-123.convex.cloud

# Scraper Configuration
TARGET_TIMEZONE=US/Eastern

# Forex Factory currency filter
ALLOWED_CURRENCY_CODES=USD

# Energy Exchange commodity filter
ALLOWED_ENERGY_CODES=OIL,NG,BRENT,WTI,NATGAS,CL,CRUDE

# Impact level filter (applies to both calendars)
ALLOWED_IMPACT_COLORS=red,gray

# API Configuration
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Data Storage Options
# Set to 'convex' to save to database, 'csv' to save to files, 'both' for both
DATA_STORAGE=both