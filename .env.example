# PostgreSQL Database Configuration
# Local Docker default from docker-compose.yml:
DATABASE_URL=postgresql://scraper:scraper_password@localhost:55432/economic_calendar

# Scraper Configuration
TARGET_TIMEZONE=US/Eastern

# Forex Factory currency filter
ALLOWED_CURRENCY_CODES=USD

# Energy Exchange commodity filter
ALLOWED_ENERGY_CODES=OIL,NG,BRENT,WTI,NATGAS,CL,CRUDE

# Impact level filter (applies to both calendars)
ALLOWED_IMPACT_COLORS=red,gray

# API Configuration
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Set this in production. When set, all endpoints except /health require this key.
API_KEY=change-me-to-a-long-random-secret

# Data Storage Options
# Options: 'postgres', 'csv', or comma-separated like 'csv,postgres'
# 'both' is treated as 'csv,postgres'
DATA_STORAGE=csv,postgres
